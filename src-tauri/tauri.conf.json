{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WowBox",
  "version": "0.1.0",
  "identifier": "cn.wowbox.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WowBox",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: https:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "简洁的魔兽世界插件管理器",
    "longDescription": "扫描并更新 macOS 与 Windows 上的多个魔兽世界客户端版本插件。"
  }
}
